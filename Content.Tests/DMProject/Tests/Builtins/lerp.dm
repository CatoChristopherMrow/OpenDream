/proc/AssertClose(A, B)
	if(abs(A - B) >= 0.0001)
		CRASH("Expected [B], got [A]")

/proc/RunTest()
	ASSERT(lerp(1,5,null) == 1)
	ASSERT(lerp(1,5,1) == 5)
	ASSERT(lerp(1,5.68,0.25) == 2.17)
	ASSERT(lerp(null,5,0.25) == 1.25)
	ASSERT(lerp(1,0,0.25) == 0.75)
	ASSERT(lerp(1,1,0.25) == 1)
	ASSERT(lerp(1,-5,0.25) == -0.5)
	ASSERT(lerp(1,5,-1) == -3)
	ASSERT(lerp(1,5,2) == 9)

	var/vector/V = lerp(vector(1, 2), vector(5, 10), 0.25)
	ASSERT(istype(V, /vector))
	ASSERT(V.len == 2)
	ASSERT(V.x == 2)
	ASSERT(V.y == 4)

	var/vector/V3 = lerp(vector(1, 2), vector(5, 10, 15), 0.25)
	ASSERT(istype(V3, /vector))
	ASSERT(V3.len == 3)
	ASSERT(V3.x == 2)
	ASSERT(V3.y == 4)
	ASSERT(V3.z == 3.75)

	var/matrix/M = lerp(matrix(1, 2, 3, 4, 5, 6), matrix(7, 8, 9, 10, 11, 12), 0.25)
	ASSERT(istype(M, /matrix))
	AssertClose(M.a, 2.19154)
	AssertClose(M.b, 3.18601)
	AssertClose(M.c, 4.5)
	AssertClose(M.d, 5.72848)
	AssertClose(M.e, 6.72247)
	AssertClose(M.f, 7.5)

	var/matrix/R = lerp(matrix(), matrix(90, MATRIX_ROTATE), 0.5)
	AssertClose(R.a, 0.707107)
	AssertClose(R.b, 0.707107)
	AssertClose(R.c, 0)
	AssertClose(R.d, -0.707107)
	AssertClose(R.e, 0.707107)
	AssertClose(R.f, 0)

	var/matrix/I = matrix(matrix(1, 2, 3, 4, 5, 6), matrix(7, 8, 9, 10, 11, 12), 0.25, MATRIX_INTERPOLATE)
	AssertClose(I.a, 2.19154)
	AssertClose(I.b, 3.18601)
	AssertClose(I.c, 4.5)
	AssertClose(I.d, 5.72848)
	AssertClose(I.e, 6.72247)
	AssertClose(I.f, 7.5)
